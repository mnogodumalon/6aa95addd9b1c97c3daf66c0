export function parseAggregateCount(data: unknown): number {
  if (!Array.isArray(data)) return 0;
  if (data.length === 0) return 0;
  const first = data[0];
  const n = Array.isArray(first) ? Number(first[0]) : Number(first);
  return Number.isFinite(n) ? n : 0;
