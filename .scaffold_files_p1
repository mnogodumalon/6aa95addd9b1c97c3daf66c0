/** Query options of GET /apps/{id}/records — filter/orderby are vSQL (see the journey layer's
 *  buildSearchFilter; never concatenate user input into them yourself). */
export interface RecordQuery {
  filter?: string;
  orderby?: string[];
  limit?: number;
  offset?: number;
